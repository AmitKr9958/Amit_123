# Copy to .env and fill only what you need.
# NEVER commit .env or put passwords in source code.

# Optional Telegram notifications (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM for screening-answer drafts (facts from profile only; always reviewable)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Browser: Microsoft Edge is the default. Set BROWSER_CHANNEL=chromium only if desired.
HEADLESS=false
BROWSER_CHANNEL=msedge
# Optional custom persistent profile directory; default is data/edge_profile for Edge.
# BROWSER_USER_DATA_DIR=
