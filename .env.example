# Copy to .env and fill only what you need.
# NEVER commit .env or put passwords in source code.

# Optional Telegram notifications (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM for screening-answer drafts (facts from profile only; always reviewable)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Browser
HEADLESS=false
BROWSER_CHANNEL=chromium
# Path to persistent profile directory (created automatically)
# BROWSER_USER_DATA_DIR=data/browser_profile
